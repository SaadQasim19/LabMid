<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AvaloniaTest.SplashWindow"
    Title="Notepad"
    Width="420"
    Height="260"
    MinWidth="420"
    MinHeight="260"
    MaxWidth="420"
    MaxHeight="260"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    CanResize="False"
    Background="#F4F7FB">

    <Border
        Background="#FFFFFF"
        BorderBrush="#DCE3ED"
        BorderThickness="1"
        CornerRadius="16"
        Padding="28">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">

            <Border
                Width="64"
                Height="64"
                CornerRadius="14"
                Background="#2563EB"
                HorizontalAlignment="Center">

                <TextBlock
                    Text="N"
                    FontSize="38"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <TextBlock
                Text="Notepad"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#172033"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Welcome to Notepad"
                FontSize="14"
                Foreground="#64748B"
                HorizontalAlignment="Center"/>

            <ProgressBar
                Width="200"
                Height="5"
                IsIndeterminate="True"/>

            <TextBlock
                Text="Starting application..."
                FontSize="12"
                Foreground="#64748B"
                HorizontalAlignment="Center"/>

        </StackPanel>
    </Border>
</Window>
